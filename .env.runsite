# ==============================================================================
# runsite-suibuff — freebuff-proxy on Runsite
#
# Optional environment variables to set in the Runsite dashboard:
# Service → Settings → Environment.
#
# The two REQUIRED ones (LISTEN_ADDR=:8080, AUTO_DISCOVER_TOKEN=false) are
# already baked into the Dockerfile — you don't need to set them here.
# Only fill in what you actually want to configure.
# ==============================================================================

# ── Mode (the only real decision) ─────────────────────────────────────────
# Comma-separated upstream FreeBuff token(s). EMPTY = bridge mode:
# the proxy stores no tokens; each client sends its own in
# Authorization: Bearer <token>. Pooled mode (tokens listed here) is best
# for one user with several accounts.
#AUTH_TOKENS=

# ── Admin dashboard protection (recommended on a public URL) ──────────────
#   openssl rand -hex 16
#ADMIN_TOKEN=

# ── Optional client auth for the OpenAI-compatible endpoint ───────────────
# When set, only requests bearing one of these keys (Authorization: Bearer
# or x-api-key) are served; leave empty to skip client auth.
#API_KEYS=

# ── Observability ────────────────────────────────────────────────────────
#LOG_LEVEL=info

# ── If you want to override the Dockerfile preset (not recommended) ───────
#LISTEN_ADDR=:8080
#AUTO_DISCOVER_TOKEN=false
#SAFE_MODE=true
#COST_MODE=free
